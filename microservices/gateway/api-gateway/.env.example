# Variables de entorno para api-gateway

# Server Configuration
PORT=3000
NODE_ENV=development

# Microservices Configuration
USER_SERVICE_URL=tcp://localhost:4001
WEATHER_SERVICE_URL=tcp://localhost:4002
NOTIFICATION_SERVICE_URL=tcp://localhost:4003
ALERT_SERVICE_URL=tcp://localhost:4004
LOG_SERVICE_URL=tcp://localhost:4005
PREFERENCE_SERVICE_URL=tcp://localhost:4006

# Security Configuration - Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
THROTTLE_AUTH_LIMIT=10
THROTTLE_DATA_LIMIT=200

# Security Configuration - Helmet
HELMET_CSP_ENABLED=true
HELMET_HSTS_ENABLED=true
HELMET_HSTS_MAX_AGE=31536000

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# Logging Configuration
LOG_LEVEL=debug
SECURITY_LOG_ENABLED=true

# Monitoring
PROMETHEUS_ENABLED=true
