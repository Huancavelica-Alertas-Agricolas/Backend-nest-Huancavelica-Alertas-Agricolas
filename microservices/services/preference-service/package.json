{
  "name": "preference-service",
  "version": "1.0.0",
  "description": "Preference Service for Agro-Alertas - Gestión de preferencias de notificación",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "m:migrate": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate -d ./src/data-source.ts ./src/migrations/${name}",
    "m:run": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d ./src/data-source.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "jest --config jest.config.json",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "test": "jest",
  "test:watch": "jest --watch",
  "test:cov": "jest --coverage",
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/microservices": "^11.1.6",
    "@nestjs/typeorm": "^11.0.0",
    "@types/jest": "^30.0.0",
    "agro-alertas-microservices": "file:../../..",
    "jest": "^30.2.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ts-jest": "^29.4.5",
    "typeorm": "^0.3.27",
    "typeorm-naming-strategies": "^4.1.0",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.1.8",
    "@types/node": "^22.18.6",
    "@types/winston": "^2.4.4",
    "ts-node": "^10.9.1",
    "typescript": "4.9.5"
  },
  "jest": "^29.5.0",
  "ts-jest": "^29.1.0",
  "@types/jest": "^29.5.2"
}
